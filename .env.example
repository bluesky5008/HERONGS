# HERONGS 설정 — 이 파일을 .env로 복사해 값 입력 (NFR-01: .env는 커밋 금지)

# 거래 모드: mock(모의투자, 기본) | real(실계좌 — 명시적 전환으로만, NFR-02)
HERONGS_TRADING_MODE=mock

# 키움 REST API (모의투자 키 포함)
HERONGS_KIWOOM_APPKEY=
HERONGS_KIWOOM_SECRETKEY=
HERONGS_ACCOUNT_NO=

# 텔레그램 알림 (FR-11/17) — 비우면 알림 비활성(로그만)
HERONGS_TELEGRAM_BOT_TOKEN=
HERONGS_TELEGRAM_CHAT_ID=

# PWA 접속 PIN (§7) — 비우면 인증 비활성(로컬 개발용)
HERONGS_PIN=

# 데이터 경로 (Docker에서는 /app/data/herongs.db 고정)
HERONGS_DB_PATH=data/herongs.db

# 유량 제한 (설계 §10 Q-03 — 모의 도메인 실측 후 보정)
HERONGS_RATE_GLOBAL_PER_SEC=5.0
HERONGS_RATE_PER_TR_PER_SEC=1.0

# 스캔·추천
HERONGS_SCAN_INTERVAL_MIN=10
HERONGS_RECOMMEND_TOP_N=10

# 주문 가드레일 (NFR-02, FR-15)
HERONGS_MAX_ORDER_AMOUNT=5000000
HERONGS_DAILY_ORDER_LIMIT=20000000

# 백업 (FR-19): 컨테이너 내 /backup 또는 NAS 마운트 경로. 비우면 백업 생략
HERONGS_BACKUP_DIR=/backup
HERONGS_BACKUP_KEEP_DAYS=14
# docker-compose에서 호스트측 NAS 마운트 지정: HERONGS_BACKUP_MOUNT=\\DS220j\backup\herongs
